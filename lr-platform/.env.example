ENVIRONMENT=production

MONGODB_URL=mongodb://user:password@host:27017/?authSource=admin
MONGODB_DATABASE=lr_platform
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=200
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=60000

SECRET_KEY=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=https://portal.example.com
CORS_ORIGINS=https://portal.example.com,https://admin.example.com
SOCKETIO_CORS_ORIGINS=https://portal.example.com,https://admin.example.com
SOCKETIO_MESSAGE_QUEUE=redis://redis:6379/0
SOCKETIO_ASYNC_MODE=gevent
SOCKETIO_WORKER_CONNECTIONS=5000
SOCKETIO_PING_INTERVAL_SECONDS=25
SOCKETIO_PING_TIMEOUT_SECONDS=60
SOCKETIO_MAX_HTTP_BUFFER_BYTES=1000000
PORTAL_HOME_URL=/portal

GUACAMOLE_URL=http://guacamole:8080/guacamole
GUACAMOLE_PUBLIC_URL=https://remote.example.com/guacamole
GUACAMOLE_USER=replace-with-guacamole-admin-user
GUACAMOLE_PASSWORD=replace-with-guacamole-admin-password
GUACAMOLE_DATA_SOURCE=mysql
GUACAMOLE_TOKEN_CACHE_SECONDS=300
REMOTEAPP_BROWSER_LAUNCH_TTL_SECONDS=120
GUACAMOLE_HTTP_POOL_SIZE=100
GUACAMOLE_CONNECT_TIMEOUT_SECONDS=3
GUACAMOLE_READ_TIMEOUT_SECONDS=10
GUACAMOLE_VISUAL_QUALITY=balanced
GUACAMOLE_ENABLE_PRINTING=true
GUACAMOLE_PRINTER_NAME=LR Remote Printer
GUACAMOLE_MAX_CONNECTIONS=1
GUACAMOLE_MAX_CONNECTIONS_PER_USER=1

UPSTREAM_MAX_CONNECTIONS=2000
UPSTREAM_MAX_KEEPALIVE=500
UPSTREAM_KEEPALIVE_EXPIRY=30

RDP_PRECHECK_ENABLED=true
FILE_TRANSFER_ROOT=
FILE_TRANSFER_MAX_UPLOAD_BYTES=100000000
FILE_TRANSFER_MAX_READ_BYTES=1000000

# Super Admin license validation. HTTPS is required to protect LR-Keys in transit.
LICENSE_VALIDATION_URL=http://license-authority:8005/public/keys/validate
LICENSE_VALIDATION_TIMEOUT_SECONDS=10
SUPER_ADMIN_MONGODB_DATABASE=test
SUPER_ADMIN_LICENSE_COLLECTION=lr_license_keys

# Tenant onboarding and company-license policy
TENANT_REGISTRATION_ENABLED=true
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=10

# Agent identity and legacy compatibility (secure defaults)
AGENT_ENROLLMENT_REQUIRED=true
AGENT_ENROLLMENT_TOKEN_EXPIRY_SECONDS=900
AGENT_REQUIRE_MACHINE_BINDING=true
# Required when running more than one web-backend worker/instance.
AGENT_PRESENCE_REDIS_URL=redis://redis:6379/2
AGENT_PRESENCE_TTL_SECONDS=75
AGENT_COMMAND_TIMEOUT_SECONDS=45
ALLOW_LEGACY_UNENROLLED_AGENTS=false
ALLOW_LEGACY_LOCAL_HOST_OPERATIONS=false
LEGACY_PUBLIC_USER_REGISTRATION_ENABLED=false

# Remote printing (watched PDF + JSON sidecars)
PRINTING_ENABLED=true
PRINTING_MAX_JOB_SIZE_MB=50
PRINTING_JOB_TIMEOUT_SECONDS=120
PRINTING_TEMP_RETENTION_SECONDS=300
PRINTING_DEFAULT_MODE=ask
PRINTING_BROWSER_FALLBACK=true
PRINTING_CHUNK_SIZE=262144
PRINTING_AUTOMATIC=false
PRINTING_ALLOWED_MODES=ask,default,preview,save,selected
PRINTING_SPOOL_ROOT=

API_GATEWAY_PORT=8000

LR_ADMIN_USERNAME=replace-admin-username
LR_ADMIN_EMAIL=admin@example.com
LR_ADMIN_PASSWORD=replace-admin-password

# Optional Desktop Client deployment defaults. Use each tenant's company_slug.
LR_COMPANY_CODE=replace-company-code

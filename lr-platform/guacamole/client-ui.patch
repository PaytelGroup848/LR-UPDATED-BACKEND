+    /**
+     * Sends Ctrl+Shift+P directly to the remote system. This provides a
+     * reliable printing action when the local browser consumes that shortcut.
+     */
+    $scope.sendLrPrintShortcut = function sendLrPrintShortcut() {
+        const CTRL_KEY = 0xFFE3;
+        const SHIFT_KEY = 0xFFE1;
+        const P_KEY = 0x0070;
+
+        $scope.$broadcast('guacSyntheticKeydown', CTRL_KEY);
+        $scope.$broadcast('guacSyntheticKeydown', SHIFT_KEY);
+        $scope.$broadcast('guacSyntheticKeydown', P_KEY);
+        $scope.$broadcast('guacSyntheticKeyup', P_KEY);
+        $scope.$broadcast('guacSyntheticKeyup', SHIFT_KEY);
+        $scope.$broadcast('guacSyntheticKeyup', CTRL_KEY);
+    };
+
